generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

model Report {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  title       String
  detail      String
  status      String   @default("PENDING") // PENDING, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}