// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id          Int      @id @default(autoincrement())  // report_id (PK)
  userId      Int?     // user_id (nullable, ถ้ามีระบบ user auth)
  fullName    String   // ชื่อ-นามสกุล
  title       String   // หัวข้อปัญหา
  description String   // รายละเอียดปัญหา
  status      String   @default("pending")  // สถานะ: pending, reviewed, resolved
  createdAt   DateTime @default(now())  // วันที่-เวลาสร้างอัตโนมัติ
  updatedAt   DateTime @updatedAt  // วันที่-เวลาอัปเดตอัตโนมัติ

  @@map("reports")  // ชื่อตารางใน DB
}
